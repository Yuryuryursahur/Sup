insertAndBuildBtn.MouseButton1Click:Connect(function()
	if isRunning then return end

	local inputVal = assetIdBox.Text
	if inputVal == "" then
		statusLabel.Text = "[ERROR]: ENTER MODEL ID OR WORKSPACE MODEL NAME"
		return
	end

	isRunning = true
	currentCompletedIndex = 0
	statusLabel.Text = "[STATUS]: LOCATING/DOWNLOADING MODEL..."

	task.spawn(function()
		local container, isWorkspaceLocal = getModelContainer(inputVal)
		if not container then
			statusLabel.Text = "[ERROR]: COULD NOT FIND/LOAD MODEL: " .. inputVal
			isRunning = false
			return
		end

		statusLabel.Text = "[STATUS]: EXTRACTING MESHES, TEXTURES & DATA..."
		currentCatalog = extractFullDetails(container)

		if not isWorkspaceLocal then
			container:Destroy()
		end

		if #currentCatalog == 0 then
			statusLabel.Text = "[ERROR]: NO VALID PARTS/MESHES FOUND IN MODEL"
			isRunning = false
			return
		end

		processCatalog(1)
	end)
end)

resumeBtn.MouseButton1Click:Connect(function()
	if isRunning then return end

	if #currentCatalog == 0 then
		statusLabel.Text = "[ERROR]: NO PREVIOUS MODEL DATA TO RESUME"
		return
	end

	if currentCompletedIndex >= #currentCatalog then
		statusLabel.Text = "[STATUS]: MODEL IS ALREADY FULLY BUILT!"
		return
	end

	isRunning = true
	statusLabel.Text = "[STATUS]: RESUMING FROM PART " .. (currentCompletedIndex + 1) .. "..."

	task.spawn(function()
		processCatalog(currentCompletedIndex + 1)
	end)
end)

stopBtn.MouseButton1Click:Connect(function()
	if isRunning then
		isRunning = false
		statusLabel.Text = "[STATUS]: PAUSING PROCESS..."
	end
end)
