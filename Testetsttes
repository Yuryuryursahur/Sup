local function getLivePlacementDelay()
	local pps = tonumber(speedBox.Text) or 5
	if pps <= 0 then pps = 5 end
	return 1 / pps
end

local function parseAssetId(assetString)
	if type(assetString) == "number" then return "rbxassetid://" .. tostring(assetString) end
	if type(assetString) == "string" and #assetString > 0 then
		local num = string.match(assetString, "%d+")
		if num then return "rbxassetid://" .. num end
	end
	return ""
end

local function parseRawId(assetString)
	if type(assetString) == "number" then return assetString end
	if type(assetString) == "string" then
		local num = string.match(assetString, "%d+")
		return tonumber(num)
	end
	return nil
end

local function getPartShape(part)
	if part:IsA("WedgePart") then return "Wedge" end
	if part:IsA("CornerWedgePart") then return "Corner" end
	if part:IsA("TrussPart") then return "Truss" end
	if part:IsA("Part") then
		if part.Shape == Enum.PartType.Cylinder then return "Cylinder" end
		if part.Shape == Enum.PartType.Ball then return "Ball" end
	end
	return "Part"
end

-- DATA EXTRACTION
local function extractFullDetails(container)
	local partCatalog = {}

	for _, descendant in ipairs(container:GetDescendants()) do
		if descendant:IsA("BasePart") then
			local entry = {
				cframe = descendant.CFrame,
				size = descendant.Size,
				color = descendant.Color,
				material = descendant.Material,
				transparency = descendant.Transparency,
				reflectance = descendant.Reflectance,
				canCollide = descendant.CanCollide,
				shape = getPartShape(descendant),
				meshId = "",
				rawMeshId = nil,
				textureId = "",
				rawTextureId = nil,
				meshScale = Vector3.new(1, 1, 1),
				meshOffset = Vector3.new(0, 0, 0),
				hasMesh = false,
				lightType = nil,
				lightColor = Color3.new(1, 1, 1),
				lightBrightness = 1,
				lightRange = 15
			}

			if descendant:IsA("MeshPart") then
				entry.hasMesh = true
				entry.meshId = parseAssetId(descendant.MeshId)
				entry.rawMeshId = parseRawId(descendant.MeshId)
				entry.textureId = parseAssetId(descendant.TextureID)
				entry.rawTextureId = parseRawId(descendant.TextureID)
				entry.meshScale = Vector3.new(1, 1, 1)
				entry.meshOffset = Vector3.new(0, 0, 0)
			end

			local specialMesh = descendant:FindFirstChildOfClass("SpecialMesh")
			if specialMesh then
				entry.hasMesh = true
				entry.meshId = parseAssetId(specialMesh.MeshId)
				entry.rawMeshId = parseRawId(specialMesh.MeshId)
				entry.textureId = parseAssetId(specialMesh.TextureId)
				entry.rawTextureId = parseRawId(specialMesh.TextureId)
				entry.meshScale = specialMesh.Scale
				entry.meshOffset = specialMesh.Offset
			end

			local decal = descendant:FindFirstChildOfClass("Decal") or descendant:FindFirstChildOfClass("Texture")
			if decal and entry.textureId == "" then
				entry.textureId = parseAssetId(decal.Texture)
				entry.rawTextureId = parseRawId(decal.Texture)
			end

			local light = descendant:FindFirstChildOfClass("PointLight") or descendant:FindFirstChildOfClass("SpotLight") or descendant:FindFirstChildOfClass("SurfaceLight")
			if light then
				entry.lightType = light.ClassName
				entry.lightColor = light.Color
				entry.lightBrightness = light.Brightness
				entry.lightRange = light.Range
			end

			table.insert(partCatalog, entry)
		end
	end

	return partCatalog
end

-- FETCH MODEL CONTAINER
local function getModelContainer(inputText)
	local id = tonumber(inputText) or parseRawId(inputText)
	if id then
		local resultContainer = Instance.new("Folder")
		resultContainer.Name = "InsertedAsset_" .. tostring(id)

		local success, objects = pcall(function()
			return game:GetObjects("rbxassetid://" .. tostring(id))
		end)

		if success and objects and #objects > 0 then
			for _, obj in ipairs(objects) do obj.Parent = resultContainer end
			return resultContainer, false
		end

		success, objects = pcall(function()
			return InsertService:LoadAsset(id)
		end)

		if success and objects then
			objects.Parent = resultContainer
			return resultContainer, false
		end
		resultContainer:Destroy()
	end

	local foundTarget = Workspace:FindFirstChild(inputText)
	if foundTarget then
		return foundTarget, true
	end

	return nil, false
end

-- REPLICATION LOGIC USING SYNC MESH REMOTES
local function placePartViaF3X(data, ServerEndpoint, offsetVector)
	local spawnedPart = nil
	local connection

	local finalCFrame = data.cframe + offsetVector

	connection = TargetFolder.ChildAdded:Connect(function(child)
		spawnedPart = child
	end)

	-- 1. Create Base Part
	pcall(function()
		ServerEndpoint:InvokeServer("CreatePart", data.shape, finalCFrame, TargetFolder)
	end)

	local t = 0
	while not spawnedPart and t < 0.25 do
		task.wait(0.01)
		t = t + 0.01
	end

	if connection then connection:Disconnect() end
	local targetPart = spawnedPart or TargetFolder:GetChildren()[#TargetFolder:GetChildren()]

	if targetPart then
		-- 2. Size
		pcall(function()
			ServerEndpoint:InvokeServer("SyncResize", {
				{ Part = targetPart, CFrame = finalCFrame, Size = data.size }
			})
		end)

		-- 3. Material
		pcall(function()
			ServerEndpoint:InvokeServer("SyncMaterial", {
				{
					Part = targetPart,
					CFrame = finalCFrame,
					Material = data.material or Enum.Material.Plastic,
					Transparency = data.transparency,
					Reflectance = data.reflectance
				}
			})
		end)

		-- 4. Color
		pcall(function()
			ServerEndpoint:InvokeServer("SyncColor", {
				{ Part = targetPart, UnionColoring = true, Color = data.color }
			})
		end)

		-- 5. Collision
		pcall(function()
			ServerEndpoint:InvokeServer("SyncCollision", {
				{ Part = targetPart, CanCollide = data.canCollide }
			})
		end)

		-- 6. Mesh & Texture Sync
		if data.hasMesh then
			pcall(function()
				ServerEndpoint:InvokeServer("CreateMeshes", {
					{ Part = targetPart }
				})
			end)

			pcall(function()
				ServerEndpoint:InvokeServer("SyncMesh", {
					{ MeshType = Enum.MeshType.FileMesh, Part = targetPart }
				})
			end)

			if data.rawMeshId then
				pcall(function()
					ServerEndpoint:InvokeServer("ExtractMeshFromAsset", data.rawMeshId)
				end)
			end

			if data.meshId ~= "" then
				pcall(function()
					ServerEndpoint:InvokeServer("SyncMesh", {
						{ Part = targetPart, MeshId = data.meshId }
					})
				end)
			end

			if data.rawTextureId then
				pcall(function()
					ServerEndpoint:InvokeServer("ExtractImageFromDecal", data.rawTextureId)
				end)
			end

			if data.textureId ~= "" then
				pcall(function()
					ServerEndpoint:InvokeServer("SyncMesh", {
						{ Part = targetPart, TextureId = data.textureId }
					})
				end)
			end

			-- SYNC EXACT MESH SCALE (Supports 0.1, Vector3.new(2, 2, 1), or any arbitrary size)
			pcall(function()
				ServerEndpoint:InvokeServer("SyncMesh", {
					{
						Scale = data.meshScale,
						Part = targetPart
					}
				})
			end)

			-- SYNC MESH OFFSET
			if data.meshOffset ~= Vector3.new(0, 0, 0) then
				pcall(function()
					ServerEndpoint:InvokeServer("SyncMesh", {
						{
							Offset = data.meshOffset,
							Part = targetPart
						}
					})
				end)
			end
		elseif data.textureId ~= "" then
			if data.rawTextureId then
				pcall(function()
					ServerEndpoint:InvokeServer("ExtractImageFromDecal", data.rawTextureId)
				end)
			end

			pcall(function()
				ServerEndpoint:InvokeServer("SyncTexture", {
					{ Part = targetPart, Texture = data.textureId }
				})
			end)
		end

		-- 7. Lights
		if data.lightType then
			pcall(function()
				ServerEndpoint:InvokeServer("CreateLights", {
					{ Part = targetPart, LightType = data.lightType }
				})
			end)

			pcall(function()
				ServerEndpoint:InvokeServer("SyncLighting", {
					{
						Part = targetPart,
						LightType = data.lightType,
						Color = data.lightColor,
						Brightness = data.lightBrightness,
						Range = data.lightRange
					}
				})
			end)
		end
	end
end

local function processCatalog(startIndex)
	local ServerEndpoint = getServerEndpoint()
	if not ServerEndpoint then
		statusLabel.Text = "[ERROR]: 'Build' TOOL NOT FOUND"
		isRunning = false
		return
	end

	local offsetVector = getOffsetVector()
	local total = #currentCatalog

	for i = startIndex, total do
		if not isRunning then break end

		placePartViaF3X(currentCatalog[i], ServerEndpoint, offsetVector)
		currentCompletedIndex = i

		statusLabel.Text = "[STATUS]: PLACING PARTS... " .. currentCompletedIndex .. " / " .. total
		task.wait(getLivePlacementDelay())
	end

	if currentCompletedIndex >= total and total > 0 then
		statusLabel.Text = "[STATUS]: PROCESS FINISHED 100%!"
		isRunning = false
	elseif not isRunning then
		statusLabel.Text = "[STATUS]: PAUSED AT PART " .. currentCompletedIndex .. " / " .. total
	end
end

