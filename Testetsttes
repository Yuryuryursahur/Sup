-- GET OFFSET VECTOR & SPEED
local function getOffsetVector()
	local x = tonumber(offsetXBox.Text) or 0
	local y = tonumber(offsetYBox.Text) or 0
	local z = tonumber(offsetZBox.Text) or 0
	return Vector3.new(x, y, z)
end

local function getPlacementDelay()
	local pps = tonumber(speedBox.Text) or 3
	if pps <= 0 then pps = 3 end
	return 1 / pps
end

-- EXTRACT NUMBER ID FROM ASSET STRINGS
local function parseAssetId(assetString)
	if type(assetString) == "number" then return assetString end
	if type(assetString) == "string" then
		local num = string.match(assetString, "%d+")
		return tonumber(num)
	end
	return nil
end

-- EXTRACT ALL PARTS, MESHES, AND TEXTURES
local function extractPartsAndMeshes(container)
	local partCatalog = {}

	for _, descendant in ipairs(container:GetDescendants()) do
		if descendant:IsA("BasePart") and descendant.Transparency < 1 then
			local entry = {
				cframe = descendant.CFrame,
				size = descendant.Size,
				color = descendant.Color,
				material = descendant.Material,
				shape = descendant:IsA("WedgePart") and "Wedge" or (descendant:IsA("CornerWedgePart") and "CornerWedge" or "Normal"),
				meshId = nil,
				textureId = nil
			}

			if descendant:IsA("MeshPart") then
				entry.meshId = parseAssetId(descendant.MeshId)
				entry.textureId = parseAssetId(descendant.TextureID)
			end

			local specialMesh = descendant:FindFirstChildOfClass("SpecialMesh")
			if specialMesh then
				entry.meshId = parseAssetId(specialMesh.MeshId)
				entry.textureId = parseAssetId(specialMesh.TextureId)
			end

			local decal = descendant:FindFirstChildOfClass("Decal") or descendant:FindFirstChildOfClass("Texture")
			if decal and not entry.textureId then
				entry.textureId = parseAssetId(decal.Texture)
			end

			table.insert(partCatalog, entry)
		end
	end

	return partCatalog
end

-- UNIVERSAL ASSET / PLACE LOADER
local function loadAssetOrPlace(id)
	local resultContainer = Instance.new("Folder")
	resultContainer.Name = "InsertedAsset_" .. tostring(id)

	local success, objects = pcall(function()
		return game:GetObjects("rbxassetid://" .. tostring(id))
	end)

	if success and objects and #objects > 0 then
		for _, obj in ipairs(objects) do
			obj.Parent = resultContainer
		end
		return resultContainer
	end

	success, objects = pcall(function()
		return InsertService:LoadAsset(id)
	end)

	if success and objects then
		objects.Parent = resultContainer
		return resultContainer
	end

	resultContainer:Destroy()
	return nil
end

-- F3X / COBALT REPLICATION METHOD
local function placePartViaF3X(data, ServerEndpoint, index, offsetVector)
	local spawnedPart = nil
	local connection

	local finalCFrame = data.cframe + offsetVector

	connection = TargetFolder.ChildAdded:Connect(function(child)
		spawnedPart = child
	end)

	-- 1. Create Base Part
	pcall(function()
		ServerEndpoint:InvokeServer(
			"CreatePart",
			data.shape == "Normal" and "Part" or data.shape,
			finalCFrame,
			TargetFolder
		)
	end)

	local t = 0
	while not spawnedPart and t < 0.25 do
		task.wait(0.01)
		t = t + 0.01
	end

	if connection then connection:Disconnect() end
	local targetPart = spawnedPart or TargetFolder:GetChildren()[#TargetFolder:GetChildren()]

	if targetPart then
		placedIndices[index] = true

		-- 2. Resize & Position
		pcall(function()
			ServerEndpoint:InvokeServer("SyncResize", {
				{
					Part = targetPart,
					CFrame = finalCFrame,
					Size = data.size
				}
			})
		end)

		-- 3. Material
		pcall(function()
			ServerEndpoint:InvokeServer("SyncMaterial", {
				{
					Part = targetPart,
					CFrame = finalCFrame,
					Material = data.material or Enum.Material.Plastic
				}
			})
		end)

		-- 4. Color
		pcall(function()
			ServerEndpoint:InvokeServer("SyncColor", {
				{
					Part = targetPart,
					UnionColoring = true,
					Color = data.color
				}
			})
		end)

		-- 5. Attach Mesh
		if data.meshId and data.meshId > 0 then
			pcall(function()
				ServerEndpoint:InvokeServer("CreateMeshes", {
					{
						Part = targetPart
					}
				})
			end)

			pcall(function()
				ServerEndpoint:InvokeServer("ExtractMeshFromAsset", data.meshId)
			end)
		end

		-- 6. Attach Texture
		if data.textureId and data.textureId > 0 then
			pcall(function()
				ServerEndpoint:InvokeServer("ExtractImageFromDecal", data.textureId)
			end)
		end
	end
end

-- SEQUENTIAL CONTROLLED BATCH RUNNER
local function runBatch(targetIndices)
	local ServerEndpoint = getServerEndpoint()
	if not ServerEndpoint then
		statusLabel.Text = "[ERROR]: 'Build' TOOL NOT FOUND IN BACKPACK/CHARACTER"
		isRunning = false
		return
	end

	local offsetVector = getOffsetVector()
	local delayTime = getPlacementDelay()
	local total = #targetIndices
	local completed = 0

	for _, i in ipairs(targetIndices) do
		if not isRunning then break end

		placePartViaF3X(currentCatalog[i], ServerEndpoint, i, offsetVector)
		completed = completed + 1
		statusLabel.Text = "[STATUS]: PLACING PARTS... " .. completed .. " / " .. total

		task.wait(delayTime)
	end

	task.wait(0.3)
	local unplacedCount = 0
	for _, idx in ipairs(targetIndices) do
		if not placedIndices[idx] then
			unplacedCount = unplacedCount + 1
		end
	end

	if unplacedCount > 0 then
		statusLabel.Text = "[STATUS]: FINISHED. " .. unplacedCount .. " UNPLACED PARTS REMAINING."
	else
		statusLabel.Text = "[STATUS]: MODEL / MESH MAP REPLICATED SUCCESSFULLY!"
	end
	isRunning = false
end

