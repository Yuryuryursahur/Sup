insertBtn.MouseButton1Click:Connect(function()
	if isRunning then return end
	local id = tonumber(assetIdBox.Text)
	if not id or id <= 0 then
		statusLabel.Text = "[ERROR]: PLEASE ENTER A VALID ID"
		return
	end

	isRunning = true
	statusLabel.Text = "[STATUS]: DOWNLOADING ASSET ID " .. id .. "..."

	task.spawn(function()
		local container = loadAssetOrPlace(id)
		if not container then
			statusLabel.Text = "[ERROR]: COULD NOT LOAD ASSET ID " .. id
			isRunning = false
			return
		end

		statusLabel.Text = "[STATUS]: SCANNING MESHES & TEXTURES..."
		currentCatalog = extractPartsAndMeshes(container)
		placedIndices = {}
		container:Destroy()

		if #currentCatalog == 0 then
			statusLabel.Text = "[ERROR]: NO VALID PARTS/MESHES FOUND IN MODEL"
			isRunning = false
			return
		end

		local indices = {}
		for i = 1, #currentCatalog do table.insert(indices, i) end
		runBatch(indices)
	end)
end)

retryBtn.MouseButton1Click:Connect(function()
	if isRunning then return end
	if #currentCatalog == 0 then
		statusLabel.Text = "[ERROR]: NO CATALOG DATA TO RETRY"
		return
	end

	local unplacedIndices = {}
	for i = 1, #currentCatalog do
		if not placedIndices[i] then
			table.insert(unplacedIndices, i)
		end
	end

	if #unplacedIndices == 0 then
		statusLabel.Text = "[STATUS]: ALL PARTS ALREADY PLACED!"
		return
	end

	isRunning = true
	statusLabel.Text = "[RETRY]: RETRYING " .. #unplacedIndices .. " UNPLACED PARTS..."
	runBatch(unplacedIndices)
end)
